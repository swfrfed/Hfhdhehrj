  <div class="cart-drawer" id="cartDrawer">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
      <h3 style="font-size:20px; font-weight:900;">ТВІЙ КОШИК</h3>
      <button onclick="toggleCart()" style="background:none; border:none; color:inherit; font-size:24px; cursor:pointer;">&times;</button>
    </div>
    <div id="cartItems" style="flex:1; overflow-y:auto;">
      <p style="opacity:0.5; text-align:center; margin-top:40px;">Кошик порожній</p>
    </div>
    <div style="border-top: 1px solid var(--card-border); padding-top: 16px;">
      <div style="display:flex; justify-content:space-between; font-weight:900; font-size:16px; margin-bottom:14px;">
        <span>РАЗОМ:</span>
        <span id="cartTotal">0 грн</span>
      </div>
      <button class="btn-main" style="width:100%; padding:14px;" onclick="alert('Замовлення оформлено!')">ОФОРМИТИ ЗАМОВЛЕННЯ</button>
    </div>
  </div>

  <script>
    // Зміна теми
    function toggleTheme() {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme');
      html.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
    }

    // Мобільне меню
    function toggleMobileMenu() {
      document.getElementById('mobileMenu').classList.toggle('open');
    }

    // Фільтрація каталогу
    function filterCatalog(category) {
      const cards = document.querySelectorAll('.product-card');
      cards.forEach(card => {
        const cats = card.getAttribute('data-cat');
        if (category === 'all' || cats.includes(category)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Вибір розміру
    function selectSize(el) {
      const parent = el.parentElement;
      parent.querySelectorAll('.size-pill').forEach(p => p.classList.remove('selected'));
      el.classList.add('selected');
    }

    // Кошик
    let cart = [];
    function toggleCart() {
      document.getElementById('cartDrawer').classList.toggle('open');
    }
    function addToCart(title, price) {
      cart.push({ title, price });
      updateCart();
      toggleCart();
    }
    function updateCart() {
      const container = document.getElementById('cartItems');
      document.getElementById('cart-count').innerText = cart.length;
      if (cart.length === 0) {
        container.innerHTML = '<p style="opacity:0.5; text-align:center; margin-top:40px;">Кошик порожній</p>';
        document.getElementById('cartTotal').innerText = '0 грн';
        return;
      }
      let subtotal = cart.reduce((sum, item) => sum + item.price, 0);
      let discount = cart.length >= 5 ? 0.10 : (cart.length === 4 ? 0.08 : (cart.length === 3 ? 0.05 : 0));
      let total = subtotal * (1 - discount);

      container.innerHTML = cart.map((item, idx) => `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid rgba(255,255,255,0.1);">
          <div>
            <div style="font-weight:900; font-size:13px;">${item.title}</div>
            <div style="font-size:11px; opacity:0.7;">${item.price} грн</div>
          </div>
          <button onclick="removeFromCart(${idx})" style="background:none; border:none; color:#ff4d4d; cursor:pointer; font-weight:900;">✕</button>
        </div>
      `).join('');
      document.getElementById('cartTotal').innerText = `${Math.round(total)} грн ${discount > 0 ? `(-${discount*100}%)` : ''}`;
    }
    function removeFromCart(idx) {
      cart.splice(idx, 1);
      updateCart();
    }

    // Рулетка
    const sectors = [
      { label: "Доставка 0 грн", color: "#111", text: "#fff" },
      { label: "Знижка 5%", color: "#e6e3da", text: "#000" },
      { label: "Знижка 10%", color: "#222", text: "#fff" },
      { label: "Стікерпак", color: "#ccc", text: "#000" },
      { label: "Знижка 15%", color: "#000", text: "#fff" }
    ];
    let currentRot = 0;
    let spinning = false;

    function drawWheel() {
      const canvas = document.getElementById('wheelCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const arc = (2 * Math.PI) / sectors.length;
      const rad = canvas.width / 2;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      sectors.forEach((s, i) => {
        const angle = i * arc;
        ctx.beginPath();
        ctx.fillStyle = s.color;
        ctx.moveTo(rad, rad);
        ctx.arc(rad, rad, rad, angle, angle + arc);
        ctx.lineTo(rad, rad);
        ctx.fill();
        ctx.save();
        ctx.translate(rad, rad);
        ctx.rotate(angle + arc / 2);
        ctx.textAlign = "right";
        ctx.fillStyle = s.text;
        ctx.font = "bold 11px Inter";
        ctx.fillText(s.label, rad - 12, 4);
        ctx.restore();
      });
    }
    function openWheelModal() {
      document.getElementById('wheelModal').classList.add('active');
      drawWheel();
    }
    function closeWheelModal() {
      document.getElementById('wheelModal').classList.remove('active');
    }
    function spinWheel() {
      if (spinning) return;
      spinning = true;
      const res = document.getElementById('wheelResult');
      res.style.display = 'none';
      const randIdx = Math.floor(Math.random() * sectors.length);
      const anglePer = 360 / sectors.length;
      const target = (sectors.length - randIdx) * anglePer - (anglePer / 2);
      const totalRot = currentRot + 1800 + target - (currentRot % 360);
      currentRot = totalRot;
      document.getElementById('wheelCanvas').style.transform = `rotate(${totalRot}deg)`;
      setTimeout(() => {
        spinning = false;
        res.innerText = "Виграш: " + sectors[randIdx].label;
        res.style.display = 'block';
      }, 5000);
    }
    window.onload = drawWheel;
  </script>
</body>
